---
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import '../../styles/artigo.css';
import { abs, trilhaNo, ISABELLA, SITE } from '../../data/marca';

// Um modelo para os 9 artigos. Cada artigo = src/data/aprender/<slug>.json (metadados, CTAs) + <slug>.html (o texto).
const meta = import.meta.glob('../../data/aprender/*.json', { eager: true, import: 'default' }) as Record<string, any>;
const corpos = import.meta.glob('../../data/aprender/*.html', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>;

export function getStaticPaths() {
  const lista = Object.values(import.meta.glob('../../data/aprender/*.json', { eager: true, import: 'default' })) as any[];
  return lista.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const a = meta[`../../data/aprender/${slug}.json`];
const corpo = corpos[`../../data/aprender/${slug}.html`];
const path = `/aprender/${slug}`;
const ogRel = a.ogImage.replace(SITE.url + '/', '');
const zap = a.whatsapp;
const externo = (href: string) => /^https?:\/\//.test(href) && !href.startsWith(SITE.url);
const icone = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.4-3c-.3-.4 0-.5.2-.7l.4-.5c.1-.2.2-.3.1-.5s-.6-1.5-.8-2-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4 5.3 5.3 0 0 0 3.2.7 2.7 2.7 0 0 0 1.8-1.3 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>`;
const waTexto = new URL(zap).searchParams.get('text') ?? '';
---
<Base
  title={a.titleTag}
  ogTitle={a.titulo}
  description={a.descricao}
  path={path}
  ogType="article"
  articleAuthor={ISABELLA.nome}
  siteName="FaçaAmigos — Centro de Terapia Comportamental"
  ogImage={ogRel}
  ogImageAlt={a.ogImageAlt}
  secao="pais"
  wa="clinica"
  waTexto={waTexto}
  cta={{ label: a.fa_cta.label, href: a.fa_cta.href, event: a.fa_cta.event }}
  jsonLd={[
    {
      '@type': 'Article',
      '@id': `${abs(path)}#artigo`,
      headline: a.titulo,
      description: a.descricao,
      image: a.imagemJsonLd,
      url: abs(path),
      inLanguage: 'pt-BR',
      datePublished: a.datePublished,
      dateModified: a.dateModified,
      author: { '@type': 'Person', '@id': `${SITE.url}/#isabella`, name: ISABELLA.nome, jobTitle: ISABELLA.papel, identifier: ISABELLA.registro, url: abs(ISABELLA.rota) },
      publisher: { '@id': `${SITE.url}/#organization` },
      about: a.about,
      isPartOf: { '@id': `${SITE.url}/aprender#colecao` },
    },
    trilhaNo(path, [{ nome: 'Início', path: '/' }, { nome: 'Aprender', path: '/aprender' }, { nome: a.titulo, path }]),
  ]}
>
  <div class="artigo-wrap">
    <p class="crumbs" style="margin: 26px 0 14px"><a href="/">Início</a> › <a href="/aprender">Aprender</a> › {a.titulo}</p>
    <article class="artigo">
      <span class="eyebrow">{a.eyebrow}</span>
      <h1>{a.titulo}</h1>
      <div class="byline">
        <Foto src={ISABELLA.foto} alt={`Foto de ${ISABELLA.nome}, psicóloga infantil`} />
        <div class="who"><a href={ISABELLA.rota}>{ISABELLA.nome}</a><span>{ISABELLA.papel} · {ISABELLA.registro} · {a.dataTexto}</span></div>
      </div>

      <div class="prosa" set:html={corpo} />

      <div class="proximo">
        <span class="lbl">{a.proximo.rotulo}</span>
        <h3>{a.proximo.titulo}</h3>
        <a class={'btn ' + (externo(a.proximo.href) ? 'btn-wa' : 'btn-pri')} href={a.proximo.href} data-cta={a.proximo.cta} target={a.proximo.externo ? '_blank' : undefined} rel={a.proximo.externo ? 'noopener' : undefined}>{a.proximo.botao}</a>
      </div>

      <div class="sozinha">
        <p>Você não está sozinha(o) nessa.</p>
        <a class="btn btn-wa" href={zap} target="_blank" rel="noopener" data-cta="sozinha"><Fragment set:html={icone} /> Chamar no WhatsApp</a>
        <p class="mais"><a href={a.clinicaLink} data-cta="clinica" data-fa-link="aprender_clinica">{a.clinicaTexto}</a></p>
      </div>

      <div class="leia-tambem">
        <h3>Leia também</h3>
        <div class="lt-grid">
          {a.leiaTambem.map((l: any) => <a class="lt-card" href={l.href}><span class="lt-tag">{l.tag}</span><b>{l.titulo}</b></a>)}
        </div>
      </div>

      <p class="aviso">{a.aviso}</p>
    </article>
  </div>
  <script is:inline define:vars={{ slug }}>
    (function () {
      function push(o) { try { (window.dataLayer = window.dataLayer || []).push(o); } catch (e) { } }
      document.querySelectorAll('[data-cta]').forEach(function (el) {
        var where = el.getAttribute('data-cta');
        el.addEventListener('click', function () { push({ event: 'aprender_cta_click', cta_location: where, slug: slug }); });
      });
    })();
  </script>
</Base>
