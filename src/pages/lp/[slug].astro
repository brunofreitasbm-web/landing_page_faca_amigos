---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import { unidades, waUrl, faqNo } from '../../data/marca';

export async function getStaticPaths() {
  const hoje = new Date(Date.now() - 3 * 3600 * 1000).toISOString().slice(0, 10);
  const todas = await getCollection('campanhas');
  return todas.filter((c) => !c.data.encerraEm || c.data.encerraEm.toISOString().slice(0, 10) >= hoje).map((c) => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const u = unidades[d.unidade];
const path = `/lp/${c.id}`;
const ehZap = d.cta.tipo === 'whatsapp';
const destino = ehZap ? (waUrl(d.unidade, d.cta.mensagem ?? `Oi! Vim pela campanha "${d.titulo}" e quero saber mais.`) as string) : (d.cta.href as string);
const track = `lp_${c.id}`;
// Etiqueta de origem na mensagem do WhatsApp (só com cta.origemNaMensagem). O fa-track.js mede o clique no GA4, mas NÃO
// leva a UTM para dentro da conversa: esta linha acrescenta "(ref: instagram-reel-ritmo-6)" ao texto, no carregamento e no clique
// (a barra fixa do celular é criada depois, por isso o clique também reescreve o link).
const scriptOrigem = `(function(){try{var q=new URLSearchParams(location.search),s=q.get('utm_source');if(!s)return;
function c(v){return (v||'').toLowerCase().replace(/[^a-z0-9_-]/g,'').slice(0,24)}
var ref=[c(s),c(q.get('utm_medium')),c(q.get('utm_campaign'))].filter(Boolean).join('-');if(!ref)return;
var sel='a[href^="https://wa.me/"]';
function fix(a){if(a.getAttribute('data-fa-ref'))return;var h=a.href,i=h.indexOf('?text=');if(i<0)return;
a.href=h.slice(0,i)+'?text='+encodeURIComponent(decodeURIComponent(h.slice(i+6))+' (ref: '+ref+')');a.setAttribute('data-fa-ref','1')}
document.addEventListener('click',function(e){var a=e.target.closest&&e.target.closest(sel);if(a)fix(a)},true);
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll(sel).forEach(fix)});
}catch(e){}})();`;
---
<Base
  title={`${d.titulo} | FaçaAmigos`}
  description={d.descricao}
  path={path}
  noindex
  minimo
  semWa
  wa={d.unidade}
  jsonLd={d.faq.length ? [faqNo(path, d.faq.map((f) => ({ q: f.q, a: f.a })))] : []}
  cta={{ label: d.cta.rotulo, href: destino, event: track }}
>
  <section class="band-petrol lp-hero">
    <div class="wrap lp-hero-grid">
      <div class="stack">
        {d.rotulo && <p class="eyebrow">{d.rotulo}</p>}
        <h1>{d.titulo}</h1>
        <p class="lead">{d.subtitulo}</p>
        {d.destaques.length > 0 && <ul class="lp-chips">{d.destaques.map((t) => <li>{t}</li>)}</ul>}
        <p><a class="btn btn-pri lp-cta" href={destino} data-fa-link={track} {...(ehZap ? { target: '_blank', rel: 'noopener' } : {})}>{d.cta.rotulo}</a></p>
        {d.cta.microtexto && <p class="lp-micro">{d.cta.microtexto}</p>}
        <p class="lp-onde">{u.nome} · {u.shopping || u.bairro}</p>
      </div>
      {d.imagem && <div class="lp-img"><Foto src={d.imagem.src} alt={d.imagem.alt} eager /></div>}
    </div>
  </section>
  <section class="section"><div class="wrap">
    <ul class="lp-beneficios">
      {d.beneficios.map((b) => <li><h2>{b.titulo}</h2><p>{b.texto}</p></li>)}
    </ul>
  </div></section>
  {d.comparacao && (
    <section class="section band-ice"><div class="wrap lp-comp">
      <h2>{d.comparacao.titulo}</h2>
      {d.comparacao.intro && <p class="lead">{d.comparacao.intro}</p>}
      <div class="lp-comp-grid">
        <div class="lp-comp-col lp-comp-antes">
          <h3>{d.comparacao.antes.rotulo}</h3>
          <ul>{d.comparacao.antes.itens.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="lp-comp-col lp-comp-depois">
          <h3>{d.comparacao.depois.rotulo}</h3>
          <ul>{d.comparacao.depois.itens.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
      {d.comparacao.nota && <p class="lp-nota">{d.comparacao.nota}</p>}
    </div></section>
  )}
  {d.passos && (
    <section class="section" id="como-funciona"><div class="wrap lp-passos">
      <h2>{d.passos.titulo}</h2>
      <ol>{d.passos.itens.map((p) => <li><h3>{p.titulo}</h3><p>{p.texto}</p></li>)}</ol>
    </div></section>
  )}
  {d.faq.length > 0 && (
    <section class="section band-ice"><div class="wrap lp-faq">
      <h2>{d.faqTitulo ?? 'Dúvidas comuns'}</h2>
      {d.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div></section>
  )}
  {d.fim ? (
    <section class="band-petrol section"><div class={`wrap lp-fim-bloco${d.fim.imagem ? ' com-img' : ''}`}>
      <div class="stack">
        <h2>{d.fim.titulo}</h2>
        {d.fim.texto && <p class="lead">{d.fim.texto}</p>}
        <p><a class="btn btn-pri lp-cta" href={destino} data-fa-link={track} {...(ehZap ? { target: '_blank', rel: 'noopener' } : {})}>{d.cta.rotulo}</a></p>
      </div>
      {d.fim.imagem && <div class="lp-img lp-img-fim"><Foto src={d.fim.imagem.src} alt={d.fim.imagem.alt} /></div>}
    </div></section>
  ) : (
    <section class="section"><div class="wrap lp-fim">
      <p><a class="btn btn-pri" href={destino} data-fa-link={track} {...(ehZap ? { target: '_blank', rel: 'noopener' } : {})}>{d.cta.rotulo}</a></p>
    </div></section>
  )}
  {d.cta.origemNaMensagem && ehZap && <script is:inline set:html={scriptOrigem} />}
</Base>
<style>
  .lp-hero { padding-block: clamp(32px, 6vw, 72px); }
  .lp-hero-grid { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 820px) { .lp-hero-grid { grid-template-columns: 1.1fr .9fr; } }
  .lp-hero h1 { color: #fff; }
  .lp-hero .lead { color: #E6F4F6; }
  .lp-onde { font-size: .9rem; opacity: .9; }
  /* :global porque o <img> é renderizado pelo componente Foto (o escopo do Astro não o alcança) */
  .lp-img :global(img) { border-radius: 24px; width: 100%; height: auto; }
  .lp-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .lp-chips li { background: rgba(255, 255, 255, .12); border: 1px solid rgba(255, 255, 255, .35); color: #fff; font-weight: 700; font-size: .92rem; line-height: 1.3; padding: 6px 14px; border-radius: 999px; }
  .lp-cta { min-height: 56px; font-size: 1.08rem; padding-inline: 28px; }
  @media (max-width: 520px) { .lp-cta { width: 100%; } }
  .lp-micro { font-size: .9rem; color: #E6F4F6; max-width: 46ch; }
  .lp-beneficios { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .lp-beneficios li { background: var(--ice); border-radius: 18px; padding: 20px; }
  .lp-beneficios h2 { font-size: 1.15rem; margin-bottom: 6px; }
  .lp-comp { display: grid; gap: 16px; }
  .lp-comp-grid { display: grid; gap: 16px; margin-top: 8px; }
  @media (min-width: 760px) { .lp-comp-grid { grid-template-columns: 1fr 1fr; } }
  .lp-comp-col { border-radius: 24px; padding: 22px 22px 18px; }
  .lp-comp-col h3 { font-size: 1.25rem; margin-bottom: 12px; }
  .lp-comp-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .lp-comp-col li { position: relative; padding-left: 30px; }
  .lp-comp-col li::before { position: absolute; left: 0; top: .05em; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; font-size: .8rem; line-height: 20px; text-align: center; }
  .lp-comp-antes { background: #fff; border: 2px dashed var(--line); }
  .lp-comp-antes h3 { color: var(--gray); }
  .lp-comp-antes li { color: var(--gray); }
  .lp-comp-antes li::before { content: '–'; background: var(--line); color: var(--petrol); }
  .lp-comp-depois { background: #fff; border: 2px solid var(--petrol); box-shadow: 0 6px 0 var(--teal); }
  .lp-comp-depois li::before { content: '✓'; background: var(--petrol); color: #fff; }
  .lp-nota { font-size: .92rem; color: var(--gray); max-width: 70ch; }
  .lp-passos h2 { margin-bottom: 18px; }
  .lp-passos ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; counter-reset: passo; }
  @media (min-width: 900px) { .lp-passos ol { grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); } }
  .lp-passos li { counter-increment: passo; position: relative; padding: 4px 0 0 60px; min-height: 48px; }
  @media (min-width: 900px) { .lp-passos li { padding: 60px 0 0; } }
  .lp-passos li::before { content: counter(passo); position: absolute; left: 0; top: 0; width: 46px; height: 46px; border-radius: 50%; background: var(--yellow); color: var(--petrol); font: 700 1.35rem/46px var(--font-display); text-align: center; }
  .lp-passos h3 { margin-bottom: 4px; }
  .lp-passos p { color: var(--gray); }
  .lp-faq h2 { margin-bottom: 14px; }
  .lp-faq details { background: #fff; border-radius: 14px; padding: 12px 16px; margin-bottom: 10px; }
  .lp-faq summary { font-weight: 800; cursor: pointer; color: var(--petrol); }
  .lp-faq details p { margin-top: 8px; }
  .lp-fim { text-align: center; }
  .lp-fim-bloco { display: grid; gap: 24px; align-items: center; }
  @media (min-width: 820px) { .lp-fim-bloco.com-img { grid-template-columns: 1.1fr .9fr; } }
  .lp-img-fim :global(img) { max-height: 380px; object-fit: cover; }
  .lp-fim-bloco .lead { color: #E6F4F6; }
</style>
