---
import '../../styles/tokens.css';
const pecas = [
  { href: '/impressos/rollup', nome: 'Roll-up', medida: '85 × 200 cm' },
  { href: '/impressos/mesa', nome: 'Display de mesa', medida: 'A5 em pé' },
  { href: '/impressos/cartao', nome: 'Cartão de visita', medida: '9 × 5 cm, frente e verso' },
];
---
<html lang="pt-BR"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>Impressos FA Tech</title><meta name="robots" content="noindex" /></head>
<body style="font-family:var(--fonte);padding:24px 16px;background:var(--gelo);color:var(--tinta)">
  <h1 style="font-weight:600;font-size:22px">Impressos</h1>
  <p style="color:var(--cinza)">Os PDFs para a gráfica saem com <code>npm run impressos</code>, na pasta <code>impressos-pdf/</code>.</p>
  <ul>{pecas.map((p) => <li><a href={p.href}>{p.nome}</a> · {p.medida}</li>)}</ul>
</body></html>
