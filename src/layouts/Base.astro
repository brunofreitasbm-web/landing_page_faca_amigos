---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import LpTopo from '../components/LpTopo.astro';
import LpRodape from '../components/LpRodape.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE, abs, waUrl } from '../data/marca';
import type { UnidadeId } from '../data/marca';
import { dims } from '../lib/img';

interface Props {
  title: string;
  ogTitle?: string; // título ao compartilhar (padrão: o da aba)
  ogDescription?: string; // descrição ao compartilhar (padrão: a da página)
  siteName?: string; // og:site_name (padrão: FaçaAmigos)
  articleAuthor?: string; // <meta property="article:author"> (artigos)
  description: string;
  path: string; // caminho canônico, ex.: "/quem-somos"
  ogImage?: string; // relativo a public/
  ogImageAlt?: string;
  ogType?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[]; // nós schema.org; vão juntos num @graph
  secao?: string; // item ativo do menu
  wa?: UnidadeId; // unidade cujo WhatsApp aparece no botão
  semWa?: boolean; // esconde o botão de WhatsApp do cabeçalho e o flutuante (páginas legais, 404)
  waTexto?: string; // mensagem inicial do WhatsApp (padrão: a da unidade)
  cta?: { label: string; href: string; event: string }; // barra de ação no celular (assets/fa-cta.js)
  minimo?: boolean; // landing de campanha: só o logo no topo e um rodapé enxuto (sem menu do site)
}
const { title, ogTitle, ogDescription, siteName = 'FaçaAmigos', articleAuthor, description, path, ogImage = 'img/og/og-hub.jpg', ogImageAlt = 'FaçaAmigos', ogType = 'website', noindex = false, jsonLd = [], secao = '', wa = 'parque', waTexto, semWa = false, cta, minimo = false } = Astro.props;
const canonical = abs(path);
// Rodapé por contexto: Playground/Circuito só com os WhatsApp do Playground; Clínica, conteúdo para pais e Mapeamento só com o da Clínica.
const rodapeContexto = ['playground', 'circuito'].includes(secao) ? 'playground'
  : (['clinica', 'pais'].includes(secao) || path.startsWith('/mapeamento')) ? 'clinica' : 'hub';
const robots = noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const imagem = abs('/' + ogImage);
const og = await dims(ogImage);
const grafo = jsonLd.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd }) : '';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <script is:inline src="/assets/fa-track.js"></script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={robots} />
  <meta name="author" content="FaçaAmigos" />
  <link rel="icon" href="/img/logo-simbolo.png" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#065264" />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imagem} />
  <meta property="og:image:width" content={String(og.width)} />
  <meta property="og:image:height" content={String(og.height)} />
  <meta property="og:image:alt" content={ogImageAlt} />
  <meta property="og:locale" content="pt_BR" />
  {articleAuthor && <meta property="article:author" content={articleAuthor} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imagem} />
  <meta name="twitter:image:alt" content={ogImageAlt} />
  <link rel="preload" href="/assets/fonts/nunito-400.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/assets/fonts/fredoka-500.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline>
    @font-face{font-family:'Fredoka One';font-style:normal;font-weight:400;font-display:swap;src:url(/assets/fonts/fredoka-one-400.woff2) format('woff2');}
    @font-face{font-family:'Fredoka';font-style:normal;font-weight:300 700;font-display:swap;src:url(/assets/fonts/fredoka-500.woff2) format('woff2');}
    @font-face{font-family:'Nunito';font-style:normal;font-weight:200 1000;font-display:swap;src:url(/assets/fonts/nunito-400.woff2) format('woff2');}
  </style>
  {grafo && <script type="application/ld+json" set:html={grafo} />}
</head>
<body>
  <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <a class="skip" href="#conteudo">Pular para o conteúdo</a>
  {minimo ? <LpTopo /> : <Nav atual={secao} wa={wa} texto={waTexto} semWa={semWa} />}
  <main id="conteudo"><slot /></main>
  {minimo ? <LpRodape wa={wa} /> : <Footer kind="hub" contexto={rodapeContexto} />}
  {!semWa && <WhatsAppFloat href={waUrl(wa, waTexto)} />}
  <script is:inline src="/assets/fa-reveal.js" defer></script>
  {cta && <script is:inline src="/assets/fa-cta.js" defer data-label={cta.label} data-href={cta.href} data-event={cta.event}></script>}
</body>
</html>
