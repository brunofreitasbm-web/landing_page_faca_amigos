// Topo das landings de campanha: só o logo (sem menu, para a pessoa não sair da página). O logo leva à home.
import Foto from './Foto.astro';
---
<header class="lp-topo"><div class="wrap"><a href="/" aria-label="FaçaAmigos: página inicial"><Foto src="img/logo-facaamigos.png" alt="FaçaAmigos" eager /></a></div></header>
<style>
  .lp-topo { background: #fff; border-bottom: 1px solid var(--line); padding: 10px 0; }
