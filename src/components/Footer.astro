---
import { unidades, CNPJ, SITE, horarioTexto, waUrl, fmtFone } from '../data/marca';
import type { UnidadeId } from '../data/marca';
// Rodapé único do site, todo em HTML estático (aparece sem JavaScript, para o Google e para quem desliga o JS).
// Dados das unidades vêm de src/data/marca.json (endereço, WhatsApp, mapa) e do geo-facts (horário).
// "kind" só alimenta o tracking dos links (data-fa-link="rodape_<kind>").
// "contexto" escolhe os cartões de unidade (rodapé por contexto, aprovado em 04/11/2026): o telefone da Clínica
// não aparece no Playground/Circuito, e os do Playground não aparecem na Clínica. "hub" mostra as três.
const { kind = 'hub', contexto = 'hub' } = Astro.props as { kind?: string; contexto?: 'hub' | 'playground' | 'clinica' };
const ordens: Record<string, UnidadeId[]> = { hub: ['parque', 'graopara', 'clinica'], playground: ['parque', 'graopara'], clinica: ['clinica'] };
const ordem: UnidadeId[] = ordens[contexto] ?? ordens.hub;
// Páginas de cada unidade (links do cartão) e o rótulo de status que o rodapé sempre mostrou na Clínica.
const paginas: Record<string, [string, string][]> = {
  parque: [['Playground', '/playground/parque-shopping'], ['Circuito', '/circuito']],
  graopara: [['Playground', '/playground/grao-para']],
  clinica: [['Clínica', '/clinica'], ['Pacotes particulares', '/planos']],
};
const status: Record<string, string> = { clinica: 'Atendendo' };
const papel: Record<string, string> = { parque: 'Playground & Circuito', graopara: 'Playground', clinica: 'Clínica' };
const rotuloWa: Record<string, string> = { parque: 'Parque', graopara: 'Grão-Pará', clinica: 'Clínica' };
const track = `rodape_${kind}`;
const minusc = (t: string) => t.toLowerCase();
// Endereço do cartão: o do próprio local, com o andar do Playground e a localização do Circuito no Parque.
function endereco(id: UnidadeId) {
  const u = unidades[id];
  if (id === 'parque') {
    const c = unidades.circuito;
    return `${u.endereco} · Playground no ${minusc(u.andar)} · Circuito no ${minusc(c.andar)}, ${c.referencia}`;
  }
  const andar = [u.andar && minusc(u.andar), u.referencia].filter(Boolean).join(', ');
  return [u.endereco, u.bairro, andar].filter(Boolean).join(' · ');
}
---
<footer data-fa-footer={kind} data-fa-contexto={contexto} class="rodape">
  <div class="rodape-wrap">
    <span class="fa-logo-card"><img class="fa-logo-img" src="/img/logo-facaamigos.png" alt="FaçaAmigos" width="1024" height="147" loading="lazy" decoding="async" /></span>
    <div class="rodape-unidades">
      {ordem.map((id) => {
        const u = unidades[id];
        const zap = waUrl(id);
        return (
          <div class="rodape-un" data-fa-unit={id}>
            <p class="rodape-nome">{u.shopping || u.nome}</p>
            <span class="rodape-papel">{papel[id]}</span>
            <p>{endereco(id)}{status[id] && <> <strong>({status[id]})</strong></>}</p>
            <p>{horarioTexto(id)}</p>
            {zap && <a class="rodape-wa" href={zap} target="_blank" rel="noopener">WhatsApp {rotuloWa[id]}: {fmtFone(u.whatsapp as string)}</a>}
            <div class="rodape-links">
              <a href={u.mapa} target="_blank" rel="noopener">Como chegar</a>
              {paginas[id].map(([nome, href]) => <a href={href}>{nome}</a>)}
            </div>
          </div>
        );
      })}
    </div>
    <div class="rodape-grade">
      <div>
        <p class="rodape-titulo">Navegação</p>
        <ul class="rodape-lista">
          <li><a href="/">Início</a></li>
          <li><a href="/clinica">Clínica: especialidades e avaliação</a></li>
          <li><a href="/planos">Pacotes particulares</a></li>
          <li><a href="/playground">Playground Inclusivo</a></li>
          <li><a href="/circuito">Circuito de Carrinhos</a></li>
          <li><a href="/mapeamento" data-fa-link={track}>Mapeamento Gratuito</a></li>
          <li><a href="/eventos">Eventos (palestras e treinamentos)</a></li>
          <li><a href="/mapa-do-site">Mapa do site</a></li>
        </ul>
      </div>
      <div>
        <p class="rodape-titulo">Conteúdos</p>
        <ul class="rodape-lista">
          <li><a href="/aprender">Aprender (Artigos &amp; Guias)</a></li>
          <li><a href="/glossario">Glossário Comportamental</a></li>
          <li><a href="/guia" data-fa-link={track}>E-book: O Brincar com Propósito</a></li>
          <li><a href="/codigo" data-fa-link={track}>E-book: O Código do Desenvolvimento Infantil</a></li>
        </ul>
      </div>
      <div>
        <p class="rodape-titulo">Especialidades e guias</p>
        <ul class="rodape-lista">
          <li><a href="/autismo">Autismo (TEA)</a></li>
          <li><a href="/tdah">TDAH</a></li>
          <li><a href="/neurodivergencia">Neurodivergência</a></li>
          <li><a href="/direitos">Direitos e como pedir</a></li>
          <li><a href="/clinica/terapia-aba">Terapia ABA</a></li>
          <li><a href="/clinica/fonoaudiologia">Fonoaudiologia</a></li>
          <li><a href="/clinica/terapia-ocupacional">Terapia Ocupacional</a></li>
          <li><a href="/clinica/psicologia-infantil">Psicologia infantil</a></li>
          <li><a href="/clinica/musicoterapia">Musicoterapia</a></li>
        </ul>
      </div>
      <div>
        <p class="rodape-titulo">Instituto Faça Amigos</p>
        <ul class="rodape-lista">
          <li>E-mail: <a href={'mailto:' + SITE.email}>{SITE.email}</a></li>
          <li>Instagram: <a href={SITE.instagram} target="_blank" rel="noopener">{SITE.instagramUser}</a></li>
          <li><a href="/quem-somos">Quem somos</a></li>
          <li><a href="/equipe/isabella-freitas">Equipe: Isabella Freitas, psicóloga infantil</a></li>
          <li><a href="/trabalhe-conosco">Faça parte do nosso time</a></li>
          <li><a href="/politica-privacidade">Política de Privacidade</a></li>
          <li><a href="/termos">Termos de Uso e de Compra</a></li>
        </ul>
      </div>
    </div>
    <div class="rodape-fim">
      <p>FaçaAmigos Playground Inclusivo · CNPJ {CNPJ.playground} (Playground e Circuito)</p>
      <p>Instituto Faça Amigos Ltda · CNPJ {CNPJ.instituto} (Clínica, Mapeamento Comportamental e e-books) · Belém/PA</p>
      <a href="#" data-fa-cookies class="rodape-cookies">Preferências de cookies</a>
    </div>
  </div>
</footer>
<script is:inline>
  // "Preferências de cookies" reabre o banner de consentimento (definido em assets/fa-track.js).
  (function () {
    var a = document.querySelector('footer [data-fa-cookies]');
    if (a) a.addEventListener('click', function (e) { e.preventDefault(); if (window.faConsentOpen) window.faConsentOpen(); });
  })();
</script>
<style is:global>
  footer.rodape { box-sizing: border-box; display: block; width: 100%; margin: 0; padding: 48px 20px 100px; background: #065264; color: #fff; text-align: left; font-size: 1rem; font-weight: 400; line-height: 1.5; border: 0; border-top: 1px solid rgba(255, 255, 255, .14); }
  footer.rodape .rodape-wrap { width: 100%; max-width: 1120px; margin: 0 auto; box-sizing: border-box; }
  footer.rodape .fa-logo-card { display: flex; width: max-content; max-width: 100%; margin: 0 0 10px; align-items: center; background: #FFF9F1; border-radius: 14px; padding: 7px 14px; line-height: 0; box-sizing: border-box; }
  footer.rodape .fa-logo-img { display: block; height: 40px; width: auto; }
  footer.rodape .rodape-unidades { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 20px 0 8px; }
  footer.rodape .rodape-un { background: rgba(255, 255, 255, .08); border: 1px solid rgba(255, 255, 255, .16); border-radius: 14px; padding: 18px 18px 16px; }
  footer.rodape .rodape-un p.rodape-nome { margin: 0; font-family: inherit; font-size: 1.02rem; font-weight: 800; line-height: 1.3; color: #fff; }
  footer.rodape .rodape-papel { display: block; margin: 2px 0 10px; font-size: .82rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; color: #FFD84D; }
  footer.rodape .rodape-un p { margin: 0 0 6px; font-size: .9rem; line-height: 1.5; color: rgba(255, 255, 255, .92); }
  footer.rodape a.rodape-wa { margin: 8px 0 4px; display: inline-flex; align-items: center; min-height: 44px; padding: 9px 16px; border-radius: 999px; background: #25D366; color: #053b1c; font-weight: 800; font-size: .9rem; text-decoration: none; }
  footer.rodape a.rodape-wa:hover { color: #053b1c; }
  footer.rodape .rodape-links { margin: 6px 0 0; font-size: .85rem; }
  footer.rodape .rodape-links a { margin-right: 14px; }
  footer.rodape .rodape-grade { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 28px 40px; margin: 28px 0; }
  footer.rodape p.rodape-titulo { margin: 0 0 14px; font-family: inherit; font-size: .8rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; opacity: .88; color: inherit; }
  footer.rodape .rodape-lista { list-style: none; padding: 0; margin: 0; }
  footer.rodape .rodape-lista li { margin: 0 0 10px; font-size: .92rem; line-height: 1.5; }
  footer.rodape a { color: inherit; font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: rgba(255, 255, 255, .4); }
  footer.rodape a:hover { color: #fff; text-decoration-color: currentColor; }
  footer.rodape .rodape-fim { border-top: 1px solid rgba(255, 255, 255, .14); padding-top: 20px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; font-size: .85rem; opacity: .95; }
  footer.rodape .rodape-fim p { margin: 0; line-height: 1.5; }
  footer.rodape a.rodape-cookies { display: inline-block; margin: 6px 10px; font-size: 13px; opacity: .85; }
  @media (max-width: 760px) { footer.rodape .fa-logo-img { height: 34px; } }
  @media (max-width: 640px) { footer.rodape { padding-left: 16px; padding-right: 16px; } }
</style>
