---
// QR Code do sorteio para projetar no telão ou imprimir. Aponta para /fatech/sorteio (tudo minúsculo).
import '../../styles/tokens.css';
import Logo from '../../components/Logo.astro';
import marca from '../../data/marca.json';
import { qrSvg } from '../../lib/qr.js';
const origem = 'palestra';
const alvo = `${marca.siteUrl}/sorteio?origem=${origem}`;
const svg = await qrSvg(alvo);
---
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>QR do sorteio | FA Tech</title>
</head>
<body>
  <main>
    <Logo tamanho="40px" tema="escuro" />
    <h1>Aponte a câmera e concorra aos brindes.</h1>
    <div class="qr" set:html={svg} />
    <p class="url">institutofacaamigos.com.br/fatech/sorteio</p>
  </main>
</body>
</html>
<style>
  body { margin: 0; min-height: 100vh; background: var(--petroleo-900); color: #fff; font-family: var(--fonte); display: grid; place-items: center; padding: 24px; box-sizing: border-box; text-align: center; }
  main { display: grid; justify-items: center; gap: 18px; }
  h1 { font-weight: 300; font-size: clamp(28px, 5vw, 56px); margin: 0; letter-spacing: -.01em; }
  .qr { background: #fff; padding: 28px; border-radius: 16px; width: min(52vh, 80vw); box-sizing: border-box; }
  .qr :global(svg) { display: block; width: 100%; height: auto; }
  .url { font-size: clamp(18px, 2.4vw, 30px); font-weight: 400; color: var(--agua); margin: 0; }
</style>
