---
// Cartão de visita 9 × 5 cm, frente e verso. Arquivo: 96 × 56 mm por página (3 mm de sangria).
import Impresso from '../../layouts/Impresso.astro';
import Logo from '../../components/Logo.astro';
import marca from '../../data/marca.json';
import { qrSvg, urlCadastro } from '../../lib/qr.js';
const qr = await qrSvg(urlCadastro('cartao'));
const site = marca.siteUrl.replace(/^https?:\/\//, '');
---
<Impresso titulo="Cartão FA Tech" larguraMm={96} alturaMm={56}>
  <section class="folha frente">
    <Logo tamanho="9mm" tema="escuro" />
    <p>Gestão para clínicas, criada dentro de uma clínica.</p>
  </section>
  <section class="folha verso">
    <div class="dados">
      <b>{marca.contato.nome}</b>
      <span class="cargo">{marca.contato.cargo}</span>
      <span>{marca.contato.whatsapp}</span>
      <span>{marca.contato.email}</span>
      <span>{site}</span>
    </div>
    <div class="qrbox">
      <div class="qr" set:html={qr} />
      <span>Teste os sistemas</span>
    </div>
  </section>
</Impresso>
<style>
  .frente { background: var(--petroleo-900); color: #fff; padding: 11mm 10mm; display: flex; flex-direction: column; justify-content: space-between; }
  .frente p { font-size: 2.9mm; font-weight: 300; opacity: .8; }
  .verso { background: #fff; padding: 9mm 9mm 9mm 10mm; display: flex; justify-content: space-between; align-items: center; gap: 5mm; }
  .dados { display: grid; gap: 1mm; font-size: 2.45mm; color: var(--cinza); }
  .dados b { font-size: 3.8mm; font-weight: 600; color: var(--petroleo-900); }
  .cargo { margin-bottom: 2mm; color: var(--petroleo-600); }
  .qrbox { display: grid; justify-items: center; gap: 1.5mm; font-size: 2.2mm; color: var(--cinza); }
  .qr { width: 22mm; height: 22mm; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
</style>
