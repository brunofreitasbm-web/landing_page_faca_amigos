---
// TV do estande (/fatech/tv) com o SITE do Instituto FaçaAmigos: mapeamento gratuito, circuito, playground inclusivo, clínica e planos.
// Cada cartão mostra uma captura real do site publicado (public/site/*.webp, tiradas em 21/11/2026) e os fatos que estão nela.
// Tempo: cada volta sorteia um total entre 5 e 8 minutos, sorteia a ordem dos blocos (abertura e encerramento ficam
// no lugar) e reparte o total entre os cartões. Parâmetros: ?total=SEGUNDOS (fixa o total da volta, para teste)
// · ?rapido=1 (3 s por cartão) · ?slide=N · ?pausa=1. Teclado: → próximo · ← anterior · espaço pausa.
// Texto: só o que está nas capturas. Número novo (preço, horário) precisa ser conferido no site antes de entrar aqui.
import '../styles/tokens.css';
import { qrSvg } from '../lib/qr.js';
import { u } from '../lib/url.js';

const SITE = 'https://institutofacaamigos.com.br';
const qr = await qrSvg(`${SITE}/?utm_source=fatech&utm_medium=tv&utm_campaign=estande`, { cor: '#05546A' });

// bloco = funcionalidade do site; cada bloco tem 1 ou 2 cartões que andam juntos
const blocos = [
  {
    id: 'mapeamento', cor: 'rosa', rotulo: 'Mapeamento gratuito', rota: '/mapeamento',
    cartoes: [
      { img: 'mapeamento-hero', titulo: 'Como está o desenvolvimento do seu filho? <em>Um retrato em 5 minutos.</em>', texto: 'Um olhar acolhedor sobre o dia a dia da criança, sem rótulo e sem julgamento. Material informativo criado por psicóloga. Não é diagnóstico.' },
      { img: 'mapeamento-gratis', titulo: '<em>100% gratuito.</em> Direto no celular.', texto: 'Cerca de 5 minutos e 25 perguntas rápidas. O retrato aparece na tela e chega no e-mail da família.', pilulas: ['~5 minutos', '25 perguntas', '100% gratuito'] },
    ],
  },
  {
    id: 'circuito', cor: 'amarelo', rotulo: 'Circuito', rota: '/circuito',
    cartoes: [
      { img: 'circuito-hero', titulo: 'Seu filho <em>no volante</em>, você logo ali por perto.', texto: 'Carrinhos elétricos por R$ 48 o passeio, no térreo do Parque Shopping Belém, em frente à C&A. Sem agendamento.', pilulas: ['R$ 48 o passeio', 'Sem agendamento'] },
      { img: 'circuito-video', titulo: 'O Circuito <em>rodando de verdade.</em>', texto: 'Vídeo real, sem edição e sem exagero, no térreo do Parque Shopping Belém. Está no site, na página do Circuito.' },
    ],
  },
  {
    id: 'playground', cor: 'agua', rotulo: 'Playground inclusivo', rota: '/playground',
    cartoes: [
      { img: 'playground-hero', titulo: 'Ele brinca <em>seguro.</em> Você finalmente descansa.', texto: 'Cadastro com pulseira, mediadores especializados e um espaço feito para todas as crianças, no Parque Shopping e no Grão-Pará.', pilulas: ['Mediadores especializados', 'Pulseira de identificação'] },
      { img: 'playground-inclusivo', titulo: 'Para todas as crianças de 0 a 12 anos, <em>com ou sem laudo.</em>', texto: 'Som mais baixo, mediador por perto e um canto para respirar. Inclusivo não é um lugar separado: é um lugar onde cabe todo mundo.', pilulas: ['0 a 12 anos', 'Com ou sem laudo'] },
    ],
  },
  {
    id: 'clinica', cor: 'rosa', rotulo: 'Clínica', rota: '/clinica',
    cartoes: [
      { img: 'clinica-hero', titulo: 'Respira. Aqui seu filho é visto, <em>e você também.</em>', texto: 'Centro de Terapia Comportamental no Umarizal, em Belém: terapia ABA, fonoaudiologia, terapia ocupacional e psicopedagogia, com equipe multidisciplinar.', pilulas: ['ABA', 'Fono', 'Terapia ocupacional', 'Psicopedagogia'] },
      { img: 'clinica-onde', titulo: 'Endereço, horário e <em>convênios.</em>', texto: 'Rua Boaventura da Silva, 1573, Umarizal. Segunda a sexta, das 8h às 18h; sábado, das 8h às 11h45. Atendemos PROASA, IASEP e também de forma particular.', pilulas: ['PROASA', 'IASEP', 'Particular'] },
    ],
  },
  {
    id: 'planos', cor: 'amarelo', rotulo: 'Planos', rota: '/planos',
    cartoes: [
      { img: 'planos-pacotes', titulo: 'Pacotes particulares <em>para cada etapa.</em>', texto: 'Primeiro Passo (4 sessões por mês), Laço (8) e Vínculo (12). Sessões de 40 minutos, 3x sem juros. Os valores são passados pela equipe no WhatsApp.', pilulas: ['4 sessões', '8 sessões', '12 sessões'] },
    ],
  },
];

let n = 0;
const cartoes = blocos.flatMap((b) => b.cartoes.map((c) => ({ ...c, bloco: b.id, cor: b.cor, rotulo: b.rotulo, rota: b.rota, i: n++, lado: n % 2 ? 'e' : 'd' })));
const img = (nome) => u(`/site/${nome}.webp`);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>FaçaAmigos · TV do estande</title>
</head>
<body>
  <div id="palco" class="palco">
    <div class="progresso" aria-hidden="true"><span id="barra"></span></div>

    <section class="cartao cartao--abertura" data-tipo="abertura" aria-hidden="true">
      <div class="abertura">
        <p class="selo anima a1">Instituto FaçaAmigos · institutofacaamigos.com.br</p>
        <h1 class="anima a2">Tudo isso, <em>num site só.</em></h1>
        <ul class="anima a3">
          {blocos.map((b) => <li class={`chip chip--${b.cor}`}>{b.rotulo}</li>)}
        </ul>
        <p class="sub anima a4">Mapeamento gratuito, circuito, playground inclusivo, clínica e planos. Aponte a câmera e veja ao vivo.</p>
      </div>
    </section>

    {cartoes.map((c) => (
      <section class={`cartao cartao--site lado-${c.lado}`} data-tipo="site" data-bloco={c.bloco} data-i={c.i} aria-hidden="true">
        <div class="navegador anima a1">
          <div class="navegador__barra"><i /><i /><i /><span>institutofacaamigos.com.br{c.rota}</span></div>
          <img src={img(c.img)} alt="" width="1920" height="1080" decoding="async" />
        </div>
        <div class="texto">
          <p class={`rotulo rotulo--${c.cor} anima a2`}>{c.rotulo}</p>
          <h2 class="anima a3" set:html={c.titulo} />
          <p class="corpo anima a4">{c.texto}</p>
          {c.pilulas && <ul class="pilulas anima a5">{c.pilulas.map((p) => <li>{p}</li>)}</ul>}
        </div>
      </section>
    ))}

    <section class="cartao cartao--fim" data-tipo="fim" aria-hidden="true">
      <div class="fim">
        <div class="fim__texto">
          <p class="selo anima a1">Conheça o site</p>
          <h2 class="anima a2">Aponte a câmera e <em>comece agora.</em></h2>
          <p class="sub anima a3">O mapeamento é gratuito e leva cerca de 5 minutos. Playground, circuito, clínica e planos estão no mesmo endereço.</p>
          <p class="url anima a4">institutofacaamigos.com.br</p>
        </div>
        <div class="fim__qr anima a3" set:html={qr} />
      </div>
    </section>

    <footer class="rodape"><span>Mapeamento gratuito</span><span>Circuito</span><span>Playground inclusivo</span><span>Clínica</span><span>Planos</span></footer>
    <div id="pausado" class="pausado" hidden>Pausado · espaço continua</div>
  </div>

  <script>
    const palco = document.getElementById('palco');
    const barra = document.getElementById('barra');
    const selo = document.getElementById('pausado');
    const todos = [...palco.querySelectorAll('.cartao')];
    const abertura = todos.find((c) => c.dataset.tipo === 'abertura');
    const fim = todos.find((c) => c.dataset.tipo === 'fim');
    const porBloco = {};
    todos.filter((c) => c.dataset.tipo === 'site').forEach((c) => (porBloco[c.dataset.bloco] ||= []).push(c));

    const q = new URLSearchParams(location.search);
    const rapido = q.get('rapido') === '1';
    const totalFixo = Number(q.get('total')) || 0;
    const MIN = 300, MAX = 480; // 5 a 8 minutos por volta
    const PESO = { abertura: 0.7, fim: 1.3, site: 1 };

    const sorteia = (a, b) => a + Math.random() * (b - a);
    function embaralha(v) {
      const r = [...v];
      for (let i = r.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [r[i], r[j]] = [r[j], r[i]]; }
      return r;
    }

    // monta uma volta: abertura, blocos em ordem sorteada (cartões do mesmo bloco juntos), encerramento.
    // Cada cartão leva um tempo proporcional ao peso; as durações somam o total sorteado.
    function planejar() {
      const total = totalFixo || Math.round(sorteia(MIN, MAX));
      const ordem = [abertura, ...embaralha(Object.keys(porBloco)).flatMap((b) => porBloco[b]), fim];
      const pesoTotal = ordem.reduce((s, c) => s + PESO[c.dataset.tipo], 0);
      return { total, ordem, durs: ordem.map((c) => (total * PESO[c.dataset.tipo]) / pesoTotal) };
    }
    window.__tvSite = { planejar, MIN, MAX };

    let plano = planejar();
    let pos = Math.min(Math.max((parseInt(q.get('slide') || '1', 10) || 1) - 1, 0), plano.ordem.length - 1);
    let pausado = q.get('pausa') === '1';
    let decorrido = 0;
    let ultimo = performance.now();
    let atual = null;

    // palco fixo em 1920x1080, escalado para caber
    function escalar() {
      const s = Math.min(innerWidth / 1920, innerHeight / 1080);
      palco.style.transform = `translate(-50%, -50%) scale(${s})`;
    }
    addEventListener('resize', escalar);
    escalar();

    const duracao = () => (rapido ? 3000 : plano.durs[pos] * 1000);

    function mostrar(i) {
      if (i >= plano.ordem.length) { plano = planejar(); i = 0; }       // acabou a volta: nova volta, novo sorteio
      if (i < 0) i = 0;
      pos = i;
      const novo = plano.ordem[pos];
      todos.forEach((c) => c.classList.remove('saindo'));
      if (atual && atual !== novo) { atual.classList.remove('ativo'); atual.classList.add('saindo'); atual.setAttribute('aria-hidden', 'true'); }
      novo.classList.add('ativo');
      novo.removeAttribute('aria-hidden');
      atual = novo;
      decorrido = 0;
      barra.style.transform = 'scaleX(0)';
    }

    setInterval(() => {
      const agora = performance.now();
      let dt = agora - ultimo;
      ultimo = agora;
      if (dt > 2000) dt = 0; // aba em segundo plano ou notebook dormiu: não pula cartões
      if (pausado) return;
      decorrido += dt;
      const d = duracao();
      barra.style.transform = `scaleX(${Math.min(decorrido / d, 1)})`;
      if (decorrido >= d) mostrar(pos + 1);
    }, 100);

    addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') mostrar(pos + 1);
      else if (e.key === 'ArrowLeft') mostrar(pos - 1);
      else if (e.key === ' ') { e.preventDefault(); pausado = !pausado; selo.hidden = !pausado; }
    });

    let tCursor;
    function mexeu() {
      document.body.classList.remove('sem-cursor');
      clearTimeout(tCursor);
      tCursor = setTimeout(() => document.body.classList.add('sem-cursor'), 3000);
    }
    addEventListener('mousemove', mexeu);
    mexeu();

    async function acordado() {
      try { if ('wakeLock' in navigator && document.visibilityState === 'visible') await navigator.wakeLock.request('screen'); } catch {}
    }
    document.addEventListener('visibilitychange', acordado);
    acordado();

    window.__tvSite.estado = () => ({ pos, total: plano.total, ordem: plano.ordem.map((c) => c.dataset.bloco || c.dataset.tipo), durs: plano.durs });
    mostrar(pos);
    selo.hidden = !pausado;
  </script>
</body>
</html>

<style is:global>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; height: 100%; overflow: hidden; background: #000; }
  body { font-family: var(--fonte); -webkit-font-smoothing: antialiased; user-select: none; }
  body.sem-cursor, body.sem-cursor * { cursor: none !important; }
  [hidden] { display: none !important; }
</style>

<style>
  .palco {
    --fundo: #FFF7F0; --petroleo: #05546A; --escuro: #0B3A47; --amarelo: #FDC41F; --rosa: #D6204E; --menta: #00B8C4;
    position: absolute; top: 50%; left: 50%; width: 1920px; height: 1080px; overflow: hidden;
    transform-origin: center center; transform: translate(-50%, -50%);
    background: var(--fundo); color: var(--escuro);
  }
  .palco::before { content: ''; position: absolute; width: 700px; height: 700px; border-radius: 50%; right: -240px; top: -300px; background: rgba(0, 184, 196, .18); }
  .palco::after { content: ''; position: absolute; width: 520px; height: 520px; border-radius: 50%; left: -220px; bottom: -260px; background: rgba(253, 196, 31, .28); }
  .progresso { position: absolute; left: 0; right: 0; top: 0; height: 8px; background: rgba(5, 84, 106, .1); z-index: 6; }
  .progresso span { display: block; height: 100%; background: var(--rosa); transform-origin: left; transform: scaleX(0); transition: transform .1s linear; }

  .cartao { position: absolute; inset: 0 0 92px; padding: 70px 90px 0; z-index: 2; opacity: 0; visibility: hidden; transform: translateX(60px);
    transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1), visibility 0s .8s; }
  .cartao.ativo { opacity: 1; visibility: visible; transform: none; transition: opacity .8s cubic-bezier(.2,.7,.2,1) .2s, transform .8s cubic-bezier(.2,.7,.2,1) .2s, visibility 0s; }
  .cartao.saindo { transform: translateX(-60px); }
  .anima { opacity: 0; transform: translateY(20px); transition: opacity .7s ease, transform .7s ease; }
  .ativo .anima { opacity: 1; transform: none; }
  .ativo .a1 { transition-delay: .3s; } .ativo .a2 { transition-delay: .45s; } .ativo .a3 { transition-delay: .65s; } .ativo .a4 { transition-delay: .85s; } .ativo .a5 { transition-delay: 1.05s; }

  :global(em) { font-style: normal; color: var(--rosa); }
  .selo { display: inline-block; align-self: flex-start; font-size: 28px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--petroleo); background: #fff; padding: 12px 28px; border-radius: 999px; box-shadow: 0 6px 24px rgba(5, 84, 106, .1); }
  .sub { font-size: 38px; line-height: 1.35; color: var(--petroleo); font-weight: 400; }

  /* abertura */
  .abertura { height: 920px; display: flex; flex-direction: column; justify-content: center; gap: 44px; max-width: 1500px; }
  .abertura h1 { font-size: 140px; line-height: 1.02; letter-spacing: -.035em; font-weight: 600; }
  .abertura ul { list-style: none; display: flex; flex-wrap: wrap; gap: 18px; }
  .chip { font-size: 34px; font-weight: 600; padding: 14px 32px; border-radius: 999px; }
  .chip--rosa { background: var(--rosa); color: #fff; }
  .chip--amarelo { background: var(--amarelo); color: var(--escuro); }
  .chip--agua { background: var(--menta); color: #fff; }

  /* cartão com captura do site */
  .cartao--site { display: grid; grid-template-columns: 1180px 1fr; gap: 64px; align-items: center; height: 920px; }
  .cartao--site.lado-d { grid-template-columns: 1fr 1180px; }
  .cartao--site.lado-d .navegador { order: 2; }
  .navegador { border-radius: 22px; overflow: hidden; background: #fff; box-shadow: 0 40px 90px rgba(5, 84, 106, .28); border: 2px solid rgba(5, 84, 106, .12); }
  .navegador img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; }
  .navegador__barra { display: flex; align-items: center; gap: 10px; padding: 0 22px; height: 52px; background: #EEF3F4; border-bottom: 1px solid #DCE5E8; }
  .navegador__barra i { width: 14px; height: 14px; border-radius: 50%; background: #CBD5DA; }
  .navegador__barra span { margin-left: 14px; flex: 1; background: #fff; border-radius: 999px; padding: 6px 22px; font-size: 21px; color: #4B6770; }
  .texto { display: flex; flex-direction: column; gap: 30px; }
  .rotulo { align-self: flex-start; font-size: 30px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; padding: 10px 26px; border-radius: 999px; }
  .rotulo--rosa { background: var(--rosa); color: #fff; }
  .rotulo--amarelo { background: var(--amarelo); color: var(--escuro); }
  .rotulo--agua { background: var(--menta); color: #fff; }
  .texto h2 { font-size: 66px; line-height: 1.08; letter-spacing: -.025em; font-weight: 600; }
  .corpo { font-size: 33px; line-height: 1.4; color: var(--petroleo); }
  .pilulas { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; }
  .pilulas li { font-size: 27px; font-weight: 600; color: var(--petroleo); background: #fff; border: 2px solid rgba(5, 84, 106, .18); padding: 8px 22px; border-radius: 999px; }

  /* encerramento */
  .fim { height: 920px; display: grid; grid-template-columns: 1fr 520px; gap: 110px; align-items: center; }
  .fim__texto { display: flex; flex-direction: column; gap: 40px; }
  .fim h2 { font-size: 118px; line-height: 1.04; letter-spacing: -.03em; font-weight: 600; }
  .url { font-size: 54px; font-weight: 600; color: var(--petroleo); }
  .fim__qr { width: 520px; height: 520px; padding: 36px; background: #fff; border-radius: 36px; box-shadow: 0 40px 90px rgba(5, 84, 106, .28); }
  .fim__qr :global(svg) { width: 100%; height: 100%; display: block; }

  .rodape { position: absolute; left: 0; right: 0; bottom: 0; height: 92px; z-index: 3; display: flex; align-items: center; justify-content: center; gap: 70px; background: var(--petroleo); color: #fff; font-size: 30px; font-weight: 600; }
  .rodape span + span::before { content: ''; display: inline-block; width: 10px; height: 10px; border-radius: 50%; background: var(--amarelo); margin-right: 70px; vertical-align: middle; }
  .pausado { position: absolute; right: 40px; top: 30px; z-index: 9; background: rgba(0,0,0,.7); color: #fff; padding: 10px 20px; border-radius: 10px; font-size: 24px; }
</style>
